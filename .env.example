# Environment Configuration
# Copy this file to .env and update values as needed

# Application Environment
ENVIRONMENT=development
DEBUG=false

# Model Configuration
MODEL_BASE_MODEL_NAME=distilbert-base-uncased
MODEL_MAX_SEQ_LENGTH=512
MODEL_BATCH_SIZE=8
MODEL_LEARNING_RATE=2e-5
MODEL_NUM_EPOCHS=3
MODEL_MAX_NEW_TOKENS=256
MODEL_TEMPERATURE=0.7
MODEL_VERSION=v1.0.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60
API_REQUEST_TIMEOUT=60

# Data Configuration
DATA_TRAIN_SPLIT=0.8
DATA_VALIDATION_SPLIT=0.1
DATA_TEST_SPLIT=0.1
DATA_RANDOM_SEED=42
DATA_MIN_TEXT_LENGTH=10
DATA_MAX_TEXT_LENGTH=10000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_PREDICTIONS=true
LOG_LATENCY=true
LOG_ERRORS=true
